# Large / raw data (keep folder placeholders; data/README.md stays tracked)
data/raw/*
!data/raw/.gitkeep
data/videos/*
!data/videos/.gitkeep

# Model weights (02_yolo/models/README.md stays tracked)
*.pt
*.onnx
*.engine
*.task
*.tflite


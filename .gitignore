# Virtual environments / secrets
.venv/
.venv-new/
venv/
.env

# IDEs
.idea/
.vscode/

# Logs (keep folder placeholder)
logs/*
!logs/.gitkeep

# Runtime outputs (keep folder placeholders)
outputs/recordings/*
!outputs/recordings/.gitkeep
outputs/debug_frames/*
!outputs/debug_frames/.gitkeep
outputs/events/*
